---
import { SOUND_META, GROUP_ORDER } from '../data/sounds';
import Word from './Word.astro';
import Sound from './Sound.astro';

interface Props {
  /** Render only this group (e.g. "Vowels"). Omit to render all groups. */
  group?: string;
}

const { group } = Astro.props;

const groups = group
  ? [group]
  : GROUP_ORDER;

const sections = groups.map(g => ({
  name: g,
  items: Object.entries(SOUND_META).filter(([, m]) => m.group === g),
})).filter(s => s.items.length > 0);
---

{sections.map(({ name, items }) => (
  <section class="phoneme-section">
    <h2>{name} <span class="count">({items.length})</span></h2>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Symbol</th>
            <th>Name</th>
            <th>Key</th>
            <th>Example</th>
            <th>Description</th>
          </tr>
        </thead>
        <tbody>
          {items.map(([id, meta]) => (
            <tr>
              <td class="cell-ipa"><Sound id={id} compact /></td>
              <td class="cell-name"><Sound id={id} labelOnly /></td>
              <td class="cell-key"><Sound id={id} keyOnly /></td>
              <td class="cell-example"><Word id={meta.examples[0]} /></td>
              <td class="cell-desc">{meta.desc}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
))}

<style>
  .phoneme-section {
    margin-bottom: 2.5rem;
  }

  .count {
    font-size: 0.85em;
    font-weight: 400;
    color: var(--color-muted);
  }

  .table-wrap {
    overflow-x: auto;
  }

  .cell-ipa {
    white-space: nowrap;
  }

  .cell-desc {
    font-size: 0.85rem;
    color: var(--color-muted);
  }
</style>
