---
import { SOUND_META } from '../data/sounds';

interface Props {
  id: string;
  link?: boolean;
  /** Show only the IPA chip, no label — for use in table cells */
  compact?: boolean;
}

const { id, link = true, compact = false } = Astro.props;
const meta = SOUND_META[id];
---

{meta ? (
  <span class="sound-inline">
    {link
      ? <a href={`/sounds/${id}`} class="sound-link">{meta.ipa}</a>
      : <span class="sound-ipa">{meta.ipa}</span>
    }
    {!compact && <span class="sound-label">{meta.label}</span>}
  </span>
) : (
  <code class="sound-missing">{id}</code>
)}

<style>
  .sound-inline {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    white-space: nowrap;
  }

  .sound-ipa,
  .sound-link {
    font-family: var(--font-mono);
    font-size: 1em;
    color: var(--color-accent-soft);
    background: rgba(124, 106, 247, 0.1);
    border: 1px solid rgba(124, 106, 247, 0.25);
    border-radius: 4px;
    padding: 0.05em 0.4em;
    text-decoration: none;
  }

  .sound-link:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    text-decoration: none;
  }

  .sound-label {
    font-size: 0.85em;
    color: var(--color-muted);
  }

  .sound-missing {
    font-size: 0.85em;
    color: var(--color-muted);
    opacity: 0.6;
  }
</style>
