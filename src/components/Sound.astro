---
import { SOUND_META } from '../data/sounds';

interface Props {
  id: string;
  link?: boolean;
  /** Show only the IPA chip, no label — for use in table cells */
  compact?: boolean;
  /** Show only the label text, no IPA chip */
  labelOnly?: boolean;
  /** Show only the respelling key */
  keyOnly?: boolean;
}

const { id, link = true, compact = false, labelOnly = false, keyOnly = false } = Astro.props;
const meta = SOUND_META[id];
---

{meta ? (
  keyOnly ? (
    link
      ? <a href={`/sounds/${id}`} class="sound-key-link"><code class="sound-key">{meta.key}</code></a>
      : <code class="sound-key">{meta.key}</code>
  ) : labelOnly ? (
    link
      ? <a href={`/sounds/${id}`} class="sound-label-link">{meta.label}</a>
      : <span class="sound-label">{meta.label}</span>
  ) : link ? (
    <a href={`/sounds/${id}`} class="sound-inline sound-link-wrap">
      <span class="sound-ipa">{meta.ipa}</span>
      {!compact && <span class="sound-label">{meta.label}</span>}
    </a>
  ) : (
    <span class="sound-inline">
      <span class="sound-ipa">{meta.ipa}</span>
      {!compact && <span class="sound-label">{meta.label}</span>}
    </span>
  )
) : (
  <code class="sound-missing">{id}</code>
)}

<style>
  .sound-inline {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    white-space: nowrap;
  }

  .sound-ipa {
    font-family: var(--font-mono);
    font-size: 1em;
    color: var(--color-accent-soft);
    background: rgba(124, 106, 247, 0.1);
    border: 1px solid rgba(124, 106, 247, 0.25);
    border-radius: 4px;
    width: 2.2em;
    height: 2.2em;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .sound-link-wrap {
    text-decoration: none;
  }

  .sound-link-wrap:hover .sound-ipa {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .sound-link-wrap .sound-label {
    text-decoration: underline;
    text-decoration-style: dotted;
    text-underline-offset: 2px;
  }

  .sound-link-wrap:hover .sound-label {
    color: var(--color-text);
  }

  .sound-key {
    font-size: 0.8rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 0.1em 0.4em;
    white-space: nowrap;
  }

  .sound-key-link {
    text-decoration: none;
  }

  .sound-key-link:hover .sound-key {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .sound-label-link {
    color: var(--color-muted);
    text-decoration: underline;
    text-decoration-style: dotted;
    text-underline-offset: 2px;
    font-size: 0.85em;
  }

  .sound-label-link:hover {
    color: var(--color-text);
  }

  .sound-label {
    font-size: 0.85em;
    color: var(--color-muted);
  }

  .sound-missing {
    font-size: 0.85em;
    color: var(--color-muted);
    opacity: 0.6;
  }
</style>
