    { "id": "f",        "ipa": "f",   "key": "F",   "label": "/f/",      "example": "fish",    "group": "Fricatives",       "desc": "Voiceless labiodental fricative, as in \"fan\", \"off\"." },
    { "id": "v",        "ipa": "v",   "key": "V",   "label": "/v/",      "example": "van",     "group": "Fricatives",       "desc": "Voiced labiodental fricative, as in \"van\", \"of\"." },
