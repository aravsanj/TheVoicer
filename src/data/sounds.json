    { "id": "dh",       "ipa": "ð",   "key": "DH",  "label": "/ð/",      "example": "this",    "group": "Fricatives",       "desc": "Voiced dental fricative, as in \"the\", \"them\", \"bathe\"." },
    { "id": "s",        "ipa": "s",   "key": "S",   "label": "/s/",      "example": "sit",     "group": "Fricatives",       "desc": "Voiceless alveolar fricative, as in \"sit\", \"pass\"." },
    { "id": "z",        "ipa": "z",   "key": "Z",   "label": "/z/",      "example": "zip",     "group": "Fricatives",       "desc": "Voiced alveolar fricative, as in \"zoo\", \"buzz\"." },
    { "id": "sh",       "ipa": "ʃ",   "key": "SH",  "label": "/ʃ/",      "example": "ship",    "group": "Fricatives",       "desc": "Voiceless postalveolar fricative, as in \"ship\", \"wish\"." },
    { "id": "zh",       "ipa": "ʒ",   "key": "ZH",  "label": "/ʒ/",      "example": "measure", "group": "Fricatives",       "desc": "Voiced postalveolar fricative, as in \"measure\", \"vision\"." },
    { "id": "h",        "ipa": "h",   "key": "H",   "label": "/h/",      "example": "hat",     "group": "Fricatives",       "desc": "Voiceless glottal fricative, as in \"hat\", \"ahead\"." },
    { "id": "ch",       "ipa": "tʃ",  "key": "CH",  "label": "/tʃ/",     "example": "chat",    "group": "Affricates",       "desc": "Voiceless postalveolar affricate, as in \"chip\", \"much\"." },
    { "id": "j",        "ipa": "dʒ",  "key": "J",   "label": "/dʒ/",     "example": "jump",    "group": "Affricates",       "desc": "Voiced postalveolar affricate, as in \"jump\", \"edge\"." },
    { "id": "m",        "ipa": "m",   "key": "M",   "label": "/m/",      "example": "map",     "group": "Nasals",           "desc": "Bilabial nasal, as in \"map\", \"him\"." },
    { "id": "n",        "ipa": "n",   "key": "N",   "label": "/n/",      "example": "nap",     "group": "Nasals",           "desc": "Alveolar nasal, as in \"nap\", \"on\"." },
    { "id": "ng",       "ipa": "ŋ",   "key": "NG",  "label": "/ŋ/",      "example": "sing",    "group": "Nasals",           "desc": "Velar nasal, as in \"sing\", \"ring\", \"think\"." },
    { "id": "l",        "ipa": "l",   "key": "L",   "label": "/l/",      "example": "lip",     "group": "Liquids & Glides", "desc": "Alveolar lateral approximant, as in \"lip\", \"well\"." },
    { "id": "r",        "ipa": "r",   "key": "R",   "label": "/r/",      "example": "red",     "group": "Liquids & Glides", "desc": "Alveolar approximant, as in \"red\", \"car\"." },
    { "id": "w",        "ipa": "w",   "key": "W",   "label": "/w/",      "example": "wet",     "group": "Liquids & Glides", "desc": "Labial-velar approximant, as in \"wet\", \"away\"." },
    { "id": "y",        "ipa": "j",   "key": "Y",   "label": "/j/",      "example": "yes",     "group": "Liquids & Glides", "desc": "Palatal approximant, as in \"yes\", \"use\", \"beyond\"." }
