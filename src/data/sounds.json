    { "id": "long-e",   "ipa": "iː",  "key": "EE",  "label": "Long E",   "example": "beat",    "group": "Vowels",           "desc": "The high front tense vowel, as in \"see\", \"be\", \"free\"." },
    { "id": "short-i",  "ipa": "ɪ",   "key": "IH",  "label": "Short I",  "example": "bit",     "group": "Vowels",           "desc": "The high front lax vowel, as in \"it\", \"him\", \"will\"." },
    { "id": "long-a",   "ipa": "eɪ",  "key": "AY",  "label": "Long A",   "example": "bait",    "group": "Vowels",           "desc": "The mid front diphthong, as in \"say\", \"make\", \"day\"." },
    { "id": "short-e",  "ipa": "ɛ",   "key": "EH",  "label": "Short E",  "example": "bet",     "group": "Vowels",           "desc": "The mid front lax vowel, as in \"end\", \"bed\", \"said\"." },
    { "id": "short-a",  "ipa": "æ",   "key": "A",   "label": "Short A",  "example": "bat",     "group": "Vowels",           "desc": "The low front vowel, as in \"and\", \"cat\", \"hand\"." },
    { "id": "short-o",  "ipa": "ɑː",  "key": "AH",  "label": "Short O",  "example": "bot",     "group": "Vowels",           "desc": "The low back vowel, as in \"hot\", \"father\", \"calm\"." },
    { "id": "aw",       "ipa": "ɔː",  "key": "AW",  "label": "AW",       "example": "bought",  "group": "Vowels",           "desc": "The mid-low back rounded vowel, as in \"law\", \"saw\", \"all\"." },
    { "id": "long-o",   "ipa": "oʊ",  "key": "OH",  "label": "Long O",   "example": "boat",    "group": "Vowels",           "desc": "The mid back diphthong, as in \"go\", \"home\", \"know\"." },
    { "id": "long-u",   "ipa": "uː",  "key": "OO",  "label": "Long U",   "example": "boot",    "group": "Vowels",           "desc": "The high back tense vowel, as in \"you\", \"true\", \"move\"." },
    { "id": "short-u",  "ipa": "ʌ",   "key": "UH",  "label": "Short U",  "example": "but",     "group": "Vowels",           "desc": "The mid-back stressed vowel, as in \"up\", \"love\", \"cup\"." },
    { "id": "schwa",    "ipa": "ə",   "key": "uh",  "label": "Schwa",    "example": "about",   "group": "Vowels",           "desc": "The unstressed mid central vowel, as in \"about\", \"balloon\", \"sofa\"." },
    { "id": "r-schwa",  "ipa": "ɚ",   "key": "ur",  "label": "R-Schwa",  "example": "better",  "group": "Vowels",           "desc": "The unstressed r-colored central vowel, as in \"better\", \"color\", \"brother\"." },
    { "id": "r-vowel",  "ipa": "ɝ",   "key": "UR",  "label": "R-Vowel",  "example": "bird",    "group": "Vowels",           "desc": "The stressed r-colored vowel, as in \"bird\", \"nurse\", \"purple\"." },
    { "id": "long-i",   "ipa": "aɪ",  "key": "I",   "label": "Long I",   "example": "bite",    "group": "Vowels",           "desc": "The low front diphthong, as in \"my\", \"time\", \"right\"." },
    { "id": "ow",       "ipa": "aʊ",  "key": "OW",  "label": "OW",       "example": "bout",    "group": "Vowels",           "desc": "The back diphthong, as in \"out\", \"now\", \"how\"." },
    { "id": "short-oo", "ipa": "ʊ",   "key": "U",   "label": "Short OO", "example": "foot",    "group": "Vowels",           "desc": "The high back lax vowel, as in \"book\", \"put\", \"could\"." },
    { "id": "oi",       "ipa": "ɔɪ",  "key": "OY",  "label": "OI",       "example": "boy",     "group": "Vowels",           "desc": "The back-front diphthong, as in \"oil\", \"join\", \"voice\"." },
    { "id": "ar",       "ipa": "ɑːr", "key": "AR",  "label": "AR",       "example": "car",     "group": "R-Controlled",     "desc": "The r-colored low back vowel, as in \"car\", \"star\", \"far\"." },
    { "id": "or",       "ipa": "ɔːr", "key": "OR",  "label": "OR",       "example": "for",     "group": "R-Controlled",     "desc": "The r-colored mid back vowel, as in \"for\", \"more\", \"four\"." },
    { "id": "air",      "ipa": "ɛr",  "key": "AIR", "label": "AIR",      "example": "care",    "group": "R-Controlled",     "desc": "The r-colored mid front vowel, as in \"care\", \"there\", \"share\"." },
    { "id": "ear",      "ipa": "ɪr",  "key": "EAR", "label": "EAR",      "example": "here",    "group": "R-Controlled",     "desc": "The r-colored high front vowel, as in \"here\", \"year\", \"near\"." },
    { "id": "oor",      "ipa": "ʊɚ",  "key": "OOR", "label": "OOR",      "example": "poor",    "group": "R-Controlled",     "desc": "The r-colored high back vowel, as in \"poor\", \"cure\", \"tour\"." },
