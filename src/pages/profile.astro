---
import { getCollection } from 'astro:content';
import '../styles/global.css';
import { db } from '../db/client';
import { lessonCompletions, bookmarks } from '../db/schema';
import { eq } from 'drizzle-orm';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');

const allLessons = await getCollection('lessons');
allLessons.sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));

const [completionRows, bookmarkRows] = await Promise.all([
  db.select({ lessonSlug: lessonCompletions.lessonSlug, completedAt: lessonCompletions.completedAt })
    .from(lessonCompletions)
    .where(eq(lessonCompletions.userId, user.id)),
  db.select({ lessonSlug: bookmarks.lessonSlug, createdAt: bookmarks.createdAt })
    .from(bookmarks)
    .where(eq(bookmarks.userId, user.id)),
]);

const completedSlugs = new Set(completionRows.map(r => r.lessonSlug));
const bookmarkedSlugs = new Set(bookmarkRows.map(r => r.lessonSlug));

const completedLessons = allLessons.filter(l => completedSlugs.has(l.id));
const bookmarkedLessons = allLessons.filter(l => bookmarkedSlugs.has(l.id));
const totalLessons = allLessons.length;
const progressPct = totalLessons > 0 ? Math.round((completedLessons.length / totalLessons) * 100) : 0;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Profile — TheVoicer</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <nav class="topnav">
      <a href="/" class="brand">TheVoicer</a>
      <a href="/lessons" class="nav-link">All Lessons</a>
      <div class="nav-auth">
        <span class="nav-email">{user.email}</span>
        <form method="POST" action="/api/auth/logout" style="display:inline">
          <button type="submit" class="btn-ghost">Sign out</button>
        </form>
      </div>
    </nav>

    <main class="profile-page">
      <header class="profile-header">
        <div class="avatar">{user.email[0].toUpperCase()}</div>
        <div class="profile-info">
          <h1>{user.email}</h1>
          <p class="profile-sub">Your pronunciation learning progress</p>
        </div>
      </header>

      <section class="stats-row">
        <div class="stat-card">
          <span class="stat-value">{completedLessons.length}</span>
          <span class="stat-label">Completed</span>
        </div>
        <div class="stat-card">
          <span class="stat-value">{bookmarkedLessons.length}</span>
          <span class="stat-label">Bookmarked</span>
        </div>
        <div class="stat-card">
          <span class="stat-value">{totalLessons}</span>
          <span class="stat-label">Total Lessons</span>
        </div>
        <div class="stat-card progress-card">
          <div class="progress-label-row">
            <span class="stat-label">Progress</span>
            <span class="progress-pct">{progressPct}%</span>
          </div>
          <div class="progress-bar-bg">
            <div class="progress-bar-fill" style={`width: ${progressPct}%`}></div>
          </div>
        </div>
      </section>

      <section class="lessons-section">
        <h2 class="section-title">Completed Lessons</h2>
        {completedLessons.length === 0 ? (
          <p class="empty-state">No lessons completed yet. <a href="/lessons">Start learning →</a></p>
        ) : (
          <div class="lesson-grid">
            {completedLessons.map(lesson => (
              <a href={`/lessons/${lesson.id}`} class="lesson-card completed">
                {lesson.data.order && <span class="card-number">Lesson {lesson.data.order}</span>}
                <span class="completed-badge">✓ Completed</span>
                <p class="card-title">{lesson.data.title}</p>
                {lesson.data.description && <p class="card-desc">{lesson.data.description}</p>}
              </a>
            ))}
          </div>
        )}
      </section>

      <section class="lessons-section">
        <h2 class="section-title">Bookmarked Lessons</h2>
        {bookmarkedLessons.length === 0 ? (
          <p class="empty-state">No bookmarks yet. Bookmark lessons while studying to find them here.</p>
        ) : (
          <div class="lesson-grid">
            {bookmarkedLessons.map(lesson => (
              <a href={`/lessons/${lesson.id}`} class="lesson-card bookmarked">
                {lesson.data.order && <span class="card-number">Lesson {lesson.data.order}</span>}
                <span class="bookmark-badge">★ Bookmarked</span>
                <p class="card-title">{lesson.data.title}</p>
                {lesson.data.description && <p class="card-desc">{lesson.data.description}</p>}
              </a>
            ))}
          </div>
        )}
      </section>
    </main>
  </body>
</html>

<style>
  .topnav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1rem 2rem;
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    background: rgba(15, 15, 19, 0.9);
    backdrop-filter: blur(12px);
    z-index: 100;
  }
  .brand {
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--color-accent);
    letter-spacing: -0.02em;
  }
  .brand:hover { text-decoration: none; color: var(--color-accent-soft); }
  .nav-link { font-size: 0.9rem; color: var(--color-muted); }
  .nav-link:hover { color: var(--color-text); }
  .nav-auth {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .nav-email { font-size: 0.85rem; color: var(--color-muted); }
  .btn-ghost {
    background: none;
    border: 1px solid var(--color-border);
    color: var(--color-muted);
    padding: 0.3rem 0.75rem;
    border-radius: 6px;
    font-size: 0.85rem;
    cursor: pointer;
  }
  .btn-ghost:hover { color: var(--color-text); border-color: var(--color-muted); }

  .profile-page {
    max-width: 860px;
    margin: 0 auto;
    padding: 3rem 2rem 5rem;
  }

  .profile-header {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }
  .avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: rgba(124, 106, 247, 0.2);
    border: 2px solid var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--color-accent);
    flex-shrink: 0;
  }
  .profile-info h1 {
    font-size: 1.4rem;
    margin: 0;
    color: var(--color-text);
  }
  .profile-sub {
    font-size: 0.9rem;
    color: var(--color-muted);
    margin: 0.25rem 0 0;
  }

  .stats-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 1rem;
    margin-bottom: 3rem;
  }
  .stat-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .stat-value {
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-accent);
    font-family: var(--font-mono);
    line-height: 1;
  }
  .stat-label {
    font-size: 0.8rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .progress-card {
    grid-column: span 2;
    justify-content: center;
  }
  .progress-label-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }
  .progress-pct {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-accent);
    font-family: var(--font-mono);
  }
  .progress-bar-bg {
    height: 8px;
    background: var(--color-border);
    border-radius: 999px;
    overflow: hidden;
  }
  .progress-bar-fill {
    height: 100%;
    background: var(--color-accent);
    border-radius: 999px;
    transition: width 0.4s ease;
  }

  .lessons-section {
    margin-bottom: 3rem;
  }
  .section-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-accent-soft);
    margin-bottom: 1.25rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--color-border);
  }
  .empty-state {
    color: var(--color-muted);
    font-size: 0.9rem;
    padding: 1.5rem;
    background: var(--color-surface);
    border: 1px dashed var(--color-border);
    border-radius: 10px;
    text-align: center;
  }

  .lesson-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
  }
  .lesson-card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 1.25rem 1.5rem;
    transition: border-color 0.15s, transform 0.15s;
    color: inherit;
    text-decoration: none;
  }
  .lesson-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    text-decoration: none;
  }
  .lesson-card.completed { border-color: rgba(124, 106, 247, 0.3); }
  .lesson-card.bookmarked { border-color: rgba(169, 156, 245, 0.25); }
  .card-number {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-accent);
    font-family: var(--font-mono);
  }
  .completed-badge {
    font-size: 0.72rem;
    color: #6ee7b7;
    font-weight: 600;
  }
  .bookmark-badge {
    font-size: 0.72rem;
    color: var(--color-accent-soft);
    font-weight: 600;
  }
  .card-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.4;
    margin: 0;
  }
  .card-desc {
    font-size: 0.82rem;
    color: var(--color-muted);
    line-height: 1.5;
    margin: 0;
  }

  @media (max-width: 600px) {
    .progress-card { grid-column: span 1; }
    .profile-header { flex-direction: column; align-items: flex-start; gap: 1rem; }
  }
</style>
