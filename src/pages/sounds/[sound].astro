---
import Navbar from '../../components/Navbar.astro';
import Word from '../../components/Word.astro';
import wordsData from '../../data/words.json';
import { SOUND_META, GROUP_ORDER } from '../../data/sounds';

export function getStaticPaths() {
  const sounds = new Set<string>();
  for (const word of wordsData) {
    for (const sound of word.sounds) sounds.add(sound);
  }
  return [...sounds].map(sound => ({ params: { sound } }));
}

const { sound } = Astro.params;
const meta = SOUND_META[sound] ?? { label: sound, ipa: '?', example: '', desc: '', group: '' };
const words = wordsData
  .filter(w => w.sounds.includes(sound))
  .sort((a, b) => a.word.localeCompare(b.word));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{meta.label} Sound {meta.ipa} — TheVoicer</title>
    <meta name="description" content={`All common English words with the ${meta.label} sound (${meta.ipa}), with IPA and stress patterns.`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>
  <body>
    <Navbar />
    <main class="page">
      <header class="page-header">
        <a href="/sounds" class="back-link">← All sounds</a>
        <div class="sound-hero">
          <span class="ipa-big">{meta.ipa}</span>
          <div class="hero-text">
            <h1>{meta.label} Sound</h1>
            <p class="hero-desc">{meta.desc}</p>
          </div>
        </div>
        <div class="stats-row">
          <span class="stat">{words.length.toLocaleString()} words</span>
          <span class="stat-sep">·</span>
          <span class="stat">as in <em>{meta.example}</em></span>
        </div>
      </header>

      <details class="key-guide">
        <summary class="key-guide-toggle">Pronunciation key <span class="key-guide-hint">IPA → respelling</span></summary>
        <div class="key-guide-body">
          {GROUP_ORDER.map(group => (
            <div class="key-section">
              <span class="key-section-label">{group}</span>
              <div class="key-grid">
                {Object.entries(SOUND_META)
                  .filter(([, m]) => m.group === group)
                  .map(([id, m]) => (
                    <div class:list={['key-chip', { 'key-chip--active': id === sound }]}>
                      <span class="key-ipa">{m.ipa}</span>
                      <span class="key-arrow">→</span>
                      <span class="key-resp">{m.key}</span>
                      <span class="key-ex">{m.example}</span>
                    </div>
                  ))
                }
              </div>
            </div>
          ))}
          <p class="key-note">Uppercase = stressed syllable · lowercase = unstressed · <em>example</em> in italics</p>
        </div>
      </details>

      <div class="filter-row">
        <input
          id="filter-input"
          type="search"
          placeholder="Filter words…"
          autocomplete="off"
          spellcheck="false"
        />
        <span id="filter-count" class="filter-count">{words.length} shown</span>
      </div>

      <div class="table-wrap">
        <table id="word-table">
          <thead>
            <tr>
              <th>Word</th>
              <th>IPA</th>
              <th>Pronunciation</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {words.map(w => (
              <tr data-word={w.word}>
                <td class="cell-word"><Word id={w.word} compact /></td>
                <td class="cell-ipa">{w.ipa}</td>
                <td class="cell-stress">{w.respelling}</td>
                <td class="cell-cambridge">
                  <a
                    href={`https://dictionary.cambridge.org/pronunciation/english/${w.word}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="cambridge-link"
                    title="Cambridge pronunciation"
                  >Cambridge ↗</a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </main>

    <script>
      const input = document.getElementById('filter-input') as HTMLInputElement;
      const countEl = document.getElementById('filter-count') as HTMLElement;
      const rows = document.querySelectorAll<HTMLTableRowElement>('#word-table tbody tr');

      input.addEventListener('input', () => {
        const q = input.value.trim().toLowerCase();
        let shown = 0;
        for (const row of rows) {
          const match = !q || row.dataset.word!.includes(q);
          row.hidden = !match;
          if (match) shown++;
        }
        countEl.textContent = `${shown} shown`;
      });
    </script>
  </body>
</html>

<style>
  .page {
    max-width: 900px;
    margin: 0 auto;
    padding: 3rem 2rem 6rem;
  }

  .back-link {
    display: inline-block;
    font-size: 0.85rem;
    color: var(--color-muted);
    margin-bottom: 2rem;
    text-decoration: none;
  }
  .back-link:hover { color: var(--color-accent-soft); text-decoration: none; }

  .sound-hero {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 1rem;
  }

  .ipa-big {
    font-family: var(--font-mono);
    font-size: 4rem;
    color: var(--color-accent);
    line-height: 1;
    flex-shrink: 0;
    background: rgba(124, 106, 247, 0.1);
    border: 1px solid rgba(124, 106, 247, 0.2);
    border-radius: 12px;
    padding: 0.5rem 1rem;
  }

  .hero-text h1 {
    font-size: 2rem;
    margin-bottom: 0.35rem;
  }

  .hero-desc {
    color: var(--color-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }

  .stats-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-muted);
    margin-bottom: 2rem;
  }

  .stats-row em {
    font-style: normal;
    color: var(--color-accent-soft);
    font-family: var(--font-mono);
  }

  .stat-sep { color: var(--color-border); }

  .filter-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  #filter-input {
    flex: 1;
    max-width: 320px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    color: var(--color-text);
    font-family: var(--font-sans);
    font-size: 0.9rem;
    padding: 0.55rem 0.9rem;
    outline: none;
    transition: border-color 0.15s;
  }

  #filter-input:focus { border-color: var(--color-accent); }
  #filter-input::placeholder { color: var(--color-muted); }

  .filter-count {
    font-size: 0.8rem;
    color: var(--color-muted);
    font-family: var(--font-mono);
  }

  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-radius: 10px;
  }

  .table-wrap table {
    margin: 0;
  }

  .table-wrap thead th:first-child { border-radius: 10px 0 0 0; }
  .table-wrap thead th:last-child  { border-radius: 0 10px 0 0; }

  .cell-word {
    font-family: var(--font-sans);
    font-weight: 500;
    color: var(--color-text);
  }

  .word-link {
    color: var(--color-text);
    text-decoration: none;
    font-weight: 500;
  }
  .word-link:hover {
    color: var(--color-accent-soft);
    text-decoration: underline;
  }

  .cell-ipa {
    color: var(--color-accent-soft);
  }

  /* Pronunciation key guide */
  .key-guide {
    border: 1px solid var(--color-border);
    border-radius: 10px;
    margin-bottom: 1.25rem;
    background: var(--color-surface);
  }

  .key-guide-toggle {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1rem;
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-text);
    list-style: none;
    user-select: none;
  }
  .key-guide-toggle::-webkit-details-marker { display: none; }
  .key-guide-toggle::before {
    content: '▸';
    font-size: 0.7rem;
    color: var(--color-muted);
    transition: transform 0.15s;
  }
  .key-guide[open] .key-guide-toggle::before { transform: rotate(90deg); }

  .key-guide-hint {
    font-size: 0.78rem;
    color: var(--color-muted);
    font-weight: 400;
  }

  .key-guide-body {
    padding: 0 1rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .key-section { display: flex; flex-direction: column; gap: 0.5rem; }

  .key-section-label {
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
  }

  .key-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .key-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.3rem 0.55rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    font-size: 0.8rem;
    background: var(--color-bg);
    white-space: nowrap;
  }

  .key-chip--active {
    border-color: var(--color-accent);
    background: rgba(124, 106, 247, 0.08);
  }

  .key-ipa {
    font-family: var(--font-mono);
    color: var(--color-accent-soft);
  }

  .key-chip--active .key-ipa { color: var(--color-accent); }

  .key-arrow { color: var(--color-border); font-size: 0.7rem; }

  .key-resp {
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--color-text);
    font-size: 0.78rem;
  }

  .key-ex {
    color: var(--color-muted);
    font-size: 0.75rem;
    font-style: italic;
  }

  .key-note {
    font-size: 0.75rem;
    color: var(--color-muted);
    margin: 0;
    padding-top: 0.25rem;
    border-top: 1px solid var(--color-border);
  }

  .key-note em { color: var(--color-accent-soft); font-style: normal; }

  .cell-stress {
    font-family: var(--font-sans);
    color: var(--color-muted);
    font-size: 0.85rem;
  }

  .cell-cambridge {
    white-space: nowrap;
  }

  .cambridge-link {
    font-size: 0.78rem;
    color: var(--color-muted);
    text-decoration: none;
    opacity: 0.6;
    transition: opacity 0.15s, color 0.15s;
  }

  .cambridge-link:hover {
    color: var(--color-accent-soft);
    opacity: 1;
    text-decoration: none;
  }

</style>
