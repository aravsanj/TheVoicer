---
import Navbar from '../../components/Navbar.astro';
import WordSearch from '../../components/WordSearch.astro';
import wordsData from '../../data/words.json';
import { SOUND_META, GROUP_ORDER } from '../../data/soundMeta';

// Compact word data for client-side search: [word, ipa, respelling, sounds[]]
const compactWords = wordsData.map(w => [w.word, w.ipa, w.respelling, w.sounds]);

const soundCounts: Record<string, number> = {};
for (const word of wordsData) {
  for (const sound of word.sounds) {
    soundCounts[sound] = (soundCounts[sound] ?? 0) + 1;
  }
}

const sounds = Object.entries(soundCounts).map(([sound, count]) => ({
  sound,
  count,
  meta: SOUND_META[sound] ?? { label: sound, ipa: '?', example: '', group: 'Other', desc: '' },
}));

const byGroup = GROUP_ORDER.map(group => ({
  group,
  items: sounds.filter(s => s.meta.group === group),
})).filter(g => g.items.length > 0);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>English Sounds — TheVoicer</title>
    <meta name="description" content="Browse all English vowel sounds with example words, IPA symbols, and stress patterns." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Lora:wght@600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>
  <body>
    <Navbar />
    <main class="page">
      <header class="page-header">
        <div class="badge">Word Reference</div>
        <h1>English Sounds</h1>
        <p class="subtitle">Browse common words grouped by vowel sound, with IPA notation and stress patterns.</p>
      </header>

      <WordSearch compactWords={compactWords} />

      {byGroup.map(({ group, items }) => (
        <section class="sound-group">
          <h2 class="group-title">{group}</h2>
          <div class="sounds-grid">
            {items.map(({ sound, count, meta }) => (
              <a href={`/sounds/${sound}`} class="sound-card">
                <div class="ipa">{meta.ipa}</div>
                <div class="card-label">{meta.label}</div>
                <div class="card-example">as in <em>{meta.example}</em></div>
                <div class="card-count">{count.toLocaleString()} words</div>
              </a>
            ))}
          </div>
        </section>
      ))}
    </main>
  </body>
</html>

<style>
  .page {
    max-width: 900px;
    margin: 0 auto;
    padding: 4rem 2rem 6rem;
  }

  .page-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-accent);
    background: rgba(124, 106, 247, 0.12);
    border: 1px solid rgba(124, 106, 247, 0.25);
    padding: 0.3rem 1rem;
    border-radius: 999px;
    margin-bottom: 1.25rem;
  }

  .page-header h1 {
    font-size: 2.8rem;
    letter-spacing: -0.02em;
    background: linear-gradient(135deg, #fff 0%, var(--color-accent-soft) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 0.75rem;
  }

  .subtitle {
    color: var(--color-muted);
    font-size: 1.05rem;
    max-width: 480px;
    margin: 0 auto;
  }

  .sound-group {
    margin-bottom: 2.5rem;
  }

  .group-title {
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-muted);
    margin-bottom: 1rem;
    border: none;
    padding: 0;
  }

  .sounds-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 1rem;
  }

  .sound-card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 1.5rem 1.25rem;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s, transform 0.15s;
  }

  .sound-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    text-decoration: none;
  }

  .ipa {
    font-family: var(--font-mono);
    font-size: 1.8rem;
    color: var(--color-accent-soft);
    line-height: 1;
    margin-bottom: 0.25rem;
  }

  .card-label {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .card-example {
    font-size: 0.82rem;
    color: var(--color-muted);
  }

  .card-example em {
    font-style: normal;
    color: var(--color-accent-soft);
  }

  .card-count {
    font-size: 0.75rem;
    color: var(--color-muted);
    margin-top: 0.5rem;
    font-family: var(--font-mono);
  }

</style>
