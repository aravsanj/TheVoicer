---
import Navbar from '../../components/Navbar.astro';
import wordsData from '../../data/words.json';

const SOUND_META: Record<string, { label: string; ipa: string; example: string; group: string }> = {
  // Vowels
  'long-e':   { label: 'Long E',    ipa: 'iː',  example: 'beat',    group: 'Vowels' },
  'short-i':  { label: 'Short I',   ipa: 'ɪ',   example: 'bit',     group: 'Vowels' },
  'long-a':   { label: 'Long A',    ipa: 'eɪ',  example: 'bait',    group: 'Vowels' },
  'short-e':  { label: 'Short E',   ipa: 'ɛ',   example: 'bet',     group: 'Vowels' },
  'short-a':  { label: 'Short A',   ipa: 'æ',   example: 'bat',     group: 'Vowels' },
  'short-o':  { label: 'Short O',   ipa: 'ɑː',  example: 'bot',     group: 'Vowels' },
  'aw':       { label: 'AW',        ipa: 'ɔː',  example: 'bought',  group: 'Vowels' },
  'long-o':   { label: 'Long O',    ipa: 'oʊ',  example: 'boat',    group: 'Vowels' },
  'long-u':   { label: 'Long U',    ipa: 'uː',  example: 'boot',    group: 'Vowels' },
  'short-u':  { label: 'Short U',   ipa: 'ʌ',   example: 'but',     group: 'Vowels' },
  'r-vowel':  { label: 'R-Vowel',   ipa: 'ɜːr', example: 'bird',    group: 'Vowels' },
  'long-i':   { label: 'Long I',    ipa: 'aɪ',  example: 'bite',    group: 'Vowels' },
  'ow':       { label: 'OW',        ipa: 'aʊ',  example: 'bout',    group: 'Vowels' },
  'short-oo': { label: 'Short OO',  ipa: 'ʊ',   example: 'foot',    group: 'Vowels' },
  'oi':       { label: 'OI',        ipa: 'ɔɪ',  example: 'boy',     group: 'Vowels' },
  // R-controlled vowels
  'ar':       { label: 'AR',        ipa: 'ɑːr', example: 'car',     group: 'R-Controlled' },
  'or':       { label: 'OR',        ipa: 'ɔːr', example: 'for',     group: 'R-Controlled' },
  'air':      { label: 'AIR',       ipa: 'ɛr',  example: 'care',    group: 'R-Controlled' },
  'ear':      { label: 'EAR',       ipa: 'ɪr',  example: 'here',    group: 'R-Controlled' },
  // Stops
  'p':        { label: '/p/',        ipa: 'p',   example: 'pat',     group: 'Stops' },
  'b':        { label: '/b/',        ipa: 'b',   example: 'bat',     group: 'Stops' },
  't':        { label: '/t/',        ipa: 't',   example: 'top',     group: 'Stops' },
  'd':        { label: '/d/',        ipa: 'd',   example: 'dog',     group: 'Stops' },
  'k':        { label: '/k/',        ipa: 'k',   example: 'cat',     group: 'Stops' },
  'g':        { label: '/g/',        ipa: 'ɡ',   example: 'get',     group: 'Stops' },
  // Fricatives
  'f':        { label: '/f/',        ipa: 'f',   example: 'fish',    group: 'Fricatives' },
  'v':        { label: '/v/',        ipa: 'v',   example: 'van',     group: 'Fricatives' },
  'th':       { label: '/θ/',        ipa: 'θ',   example: 'think',   group: 'Fricatives' },
  'dh':       { label: '/ð/',        ipa: 'ð',   example: 'this',    group: 'Fricatives' },
  's':        { label: '/s/',        ipa: 's',   example: 'sit',     group: 'Fricatives' },
  'z':        { label: '/z/',        ipa: 'z',   example: 'zip',     group: 'Fricatives' },
  'sh':       { label: '/ʃ/',        ipa: 'ʃ',   example: 'ship',    group: 'Fricatives' },
  'zh':       { label: '/ʒ/',        ipa: 'ʒ',   example: 'measure', group: 'Fricatives' },
  'h':        { label: '/h/',        ipa: 'h',   example: 'hat',     group: 'Fricatives' },
  // Affricates
  'ch':       { label: '/tʃ/',       ipa: 'tʃ',  example: 'chat',    group: 'Affricates' },
  'j':        { label: '/dʒ/',       ipa: 'dʒ',  example: 'jump',    group: 'Affricates' },
  // Nasals
  'm':        { label: '/m/',        ipa: 'm',   example: 'map',     group: 'Nasals' },
  'n':        { label: '/n/',        ipa: 'n',   example: 'nap',     group: 'Nasals' },
  'ng':       { label: '/ŋ/',        ipa: 'ŋ',   example: 'sing',    group: 'Nasals' },
  // Liquids & Glides
  'l':        { label: '/l/',        ipa: 'l',   example: 'lip',     group: 'Liquids & Glides' },
  'r':        { label: '/r/',        ipa: 'r',   example: 'red',     group: 'Liquids & Glides' },
  'w':        { label: '/w/',        ipa: 'w',   example: 'wet',     group: 'Liquids & Glides' },
  'y':        { label: '/j/',        ipa: 'j',   example: 'yes',     group: 'Liquids & Glides' },
};

const soundCounts: Record<string, number> = {};
for (const word of wordsData) {
  for (const sound of word.sounds) {
    soundCounts[sound] = (soundCounts[sound] ?? 0) + 1;
  }
}

const GROUP_ORDER = ['Vowels', 'R-Controlled', 'Stops', 'Fricatives', 'Affricates', 'Nasals', 'Liquids & Glides'];

const sounds = Object.entries(soundCounts).map(([sound, count]) => ({
  sound,
  count,
  meta: SOUND_META[sound] ?? { label: sound, ipa: '?', example: '', group: 'Other' },
}));

const byGroup = GROUP_ORDER.map(group => ({
  group,
  items: sounds.filter(s => s.meta.group === group),
})).filter(g => g.items.length > 0);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>English Sounds — TheVoicer</title>
    <meta name="description" content="Browse all English vowel sounds with example words, IPA symbols, and stress patterns." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>
  <body>
    <Navbar />
    <main class="page">
      <header class="page-header">
        <div class="badge">Word Reference</div>
        <h1>English Sounds</h1>
        <p class="subtitle">Browse common words grouped by vowel sound, with IPA notation and stress patterns.</p>
      </header>

      {byGroup.map(({ group, items }) => (
        <section class="sound-group">
          <h2 class="group-title">{group}</h2>
          <div class="sounds-grid">
            {items.map(({ sound, count, meta }) => (
              <a href={`/sounds/${sound}`} class="sound-card">
                <div class="ipa">{meta.ipa}</div>
                <div class="card-label">{meta.label}</div>
                <div class="card-example">as in <em>{meta.example}</em></div>
                <div class="card-count">{count.toLocaleString()} words</div>
              </a>
            ))}
          </div>
        </section>
      ))}
    </main>
  </body>
</html>

<style>
  .page {
    max-width: 900px;
    margin: 0 auto;
    padding: 4rem 2rem 6rem;
  }

  .page-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-accent);
    background: rgba(124, 106, 247, 0.12);
    border: 1px solid rgba(124, 106, 247, 0.25);
    padding: 0.3rem 1rem;
    border-radius: 999px;
    margin-bottom: 1.25rem;
  }

  .page-header h1 {
    font-size: 2.8rem;
    letter-spacing: -0.02em;
    background: linear-gradient(135deg, #fff 0%, var(--color-accent-soft) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 0.75rem;
  }

  .subtitle {
    color: var(--color-muted);
    font-size: 1.05rem;
    max-width: 480px;
    margin: 0 auto;
  }

  .sound-group {
    margin-bottom: 2.5rem;
  }

  .group-title {
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-muted);
    margin-bottom: 1rem;
    border: none;
    padding: 0;
  }

  .sounds-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 1rem;
  }

  .sound-card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 1.5rem 1.25rem;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s, transform 0.15s;
  }

  .sound-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    text-decoration: none;
  }

  .ipa {
    font-family: var(--font-mono);
    font-size: 1.8rem;
    color: var(--color-accent-soft);
    line-height: 1;
    margin-bottom: 0.25rem;
  }

  .card-label {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .card-example {
    font-size: 0.82rem;
    color: var(--color-muted);
  }

  .card-example em {
    font-style: normal;
    color: var(--color-accent-soft);
  }

  .card-count {
    font-size: 0.75rem;
    color: var(--color-muted);
    margin-top: 0.5rem;
    font-family: var(--font-mono);
  }
</style>
