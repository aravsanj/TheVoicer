---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import { getCollection } from 'astro:content';

const lessons = (await getCollection('lessons')).sort(
  (a, b) => (a.data.order ?? 999) - (b.data.order ?? 999)
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TheVoicer — English Pronunciation Lessons</title>
    <meta name="description" content="Master American English phonetics with structured lessons on IPA sounds, pronunciation, and more." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <Navbar />
    <main class="home">
      <header class="hero">
        <div class="hero-badge">American English Phonetics</div>
        <h1>TheVoicer</h1>
        <p class="hero-sub">Master pronunciation through structured lessons on IPA symbols, sounds, and articulation.</p>
      </header>

      <section class="lessons-section">
        <h2 class="section-title">Lessons</h2>
        <div class="lesson-grid">
          {lessons.map(lesson => (
            <a href={`/lessons/${lesson.id}`} class="lesson-card">
              {lesson.data.order && (
                <span class="card-number">#{lesson.data.order}</span>
              )}
              <h3 class="card-title">{lesson.data.title}</h3>
              {lesson.data.description && (
                <p class="card-desc">{lesson.data.description}</p>
              )}
              {lesson.data.tags && lesson.data.tags.length > 0 && (
                <div class="card-tags">
                  {lesson.data.tags.slice(0, 3).map(tag => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              )}
              <span class="card-cta">Start lesson →</span>
            </a>
          ))}
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  .home {
    max-width: 900px;
    margin: 0 auto;
    padding: 4rem 2rem 6rem;
  }

  .hero {
    text-align: center;
    margin-bottom: 4rem;
  }
  .hero-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-accent);
    background: rgba(124, 106, 247, 0.12);
    border: 1px solid rgba(124, 106, 247, 0.25);
    padding: 0.3rem 1rem;
    border-radius: 999px;
    margin-bottom: 1.25rem;
  }
  .hero h1 {
    font-size: 3.5rem;
    letter-spacing: -0.03em;
    background: linear-gradient(135deg, #fff 0%, var(--color-accent-soft) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 1rem;
  }
  .hero-sub {
    color: var(--color-muted);
    font-size: 1.1rem;
    max-width: 520px;
    margin: 0 auto;
    line-height: 1.7;
  }

  .section-title {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-muted);
    margin-bottom: 1.25rem;
    border: none;
    padding: 0;
  }

  .lesson-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1rem;
  }

  .lesson-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 1.5rem;
    transition: border-color 0.15s, transform 0.15s;
    color: inherit;
    text-decoration: none;
  }
  .lesson-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    text-decoration: none;
  }
  .card-number {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-accent);
    font-family: var(--font-mono);
  }
  .card-title {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.4;
    margin: 0;
  }
  .card-desc {
    font-size: 0.875rem;
    color: var(--color-muted);
    line-height: 1.6;
    margin: 0;
    flex: 1;
  }
  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.25rem;
  }
  .tag {
    font-size: 0.7rem;
    background: var(--color-tag);
    color: var(--color-muted);
    padding: 0.2rem 0.5rem;
    border-radius: 3px;
    border: 1px solid var(--color-border);
  }
  .card-cta {
    font-size: 0.8rem;
    color: var(--color-accent-soft);
    margin-top: 0.5rem;
    font-weight: 500;
  }
</style>
